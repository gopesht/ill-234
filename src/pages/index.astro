---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort();
const locations = [...new Set(jobs.map((job) => job.location))].sort();
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length > 0 && (
      <div class="mb-6 grid grid-cols-1 sm:grid-cols-2 gap-4" data-testid="role-filters">
        <div>
          <label for="department-filter" class="block text-sm font-medium text-slate-200 mb-2">
            Department
          </label>
          <select
            id="department-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            data-testid="department-filter"
          >
            <option value="">All departments</option>
            {departments.map((department) => <option value={department}>{department}</option>)}
          </select>
        </div>
        <div>
          <label for="location-filter" class="block text-sm font-medium text-slate-200 mb-2">
            Location
          </label>
          <select
            id="location-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            data-testid="location-filter"
          >
            <option value="">All locations</option>
            {locations.map((location) => <option value={location}>{location}</option>)}
          </select>
        </div>
      </div>
    )}

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        data-testid="roles-grid"
      >
        {jobs.map((job) => <RoleCard job={job} />)}
      </div>
    )}
    <p
      class="mt-6 text-slate-400"
      role="status"
      aria-live="polite"
      data-testid="roles-empty-results"
      hidden
    >
      No roles match those filters. Try changing or clearing a filter.
    </p>
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';

  const initializeRoleFilters = (): void => {
    const departmentFilter = document.querySelector<HTMLSelectElement>(
      '[data-testid="department-filter"]',
    );
    const locationFilter = document.querySelector<HTMLSelectElement>(
      '[data-testid="location-filter"]',
    );
    const emptyResults = document.querySelector<HTMLElement>(
      '[data-testid="roles-empty-results"]',
    );
    const roleCards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-testid="role-card"]'),
    );

    if (roleCards.length === 0) {
      return;
    }

    if (!departmentFilter || !locationFilter || !emptyResults) {
      throw new Error('Role filter controls and empty-results message must exist when roles are present.');
    }

    const roles = roleCards.map((element) => {
      const { department, location } = element.dataset;
      if (!department || !location) {
        throw new Error('Role cards must provide department and location filter data.');
      }
      return { element, department, location };
    });

    const updateVisibleRoles = (): void => {
      const matchingRoles = filterJobs(roles, {
        department: departmentFilter.value,
        location: locationFilter.value,
      });
      const visibleElements = new Set(matchingRoles.map((role) => role.element));

      for (const { element } of roles) {
        element.hidden = !visibleElements.has(element);
      }
      emptyResults.hidden = matchingRoles.length > 0;
    };

    departmentFilter.addEventListener('change', updateVisibleRoles);
    locationFilter.addEventListener('change', updateVisibleRoles);
  };

  initializeRoleFilters();
</script>
